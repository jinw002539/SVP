APP_NAME="Comunidade São Vicente de Paulo"
APP_ENV=production
APP_DEBUG=false                 # NUNCA true em produção (mostra segredos nos erros)
APP_URL=https://O-TEU-DOMINIO
APP_TIMEZONE=Africa/Maputo
APP_LOCALE=pt
APP_KEY=                        # php artisan key:generate

LOG_LEVEL=warning

# Base de dados (preencher depois de escolher a hospedagem)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessão e cookies
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
BCRYPT_ROUNDS=12

CACHE_STORE=file

# Só para o primeiro "php artisan db:seed". Depois APAGUE ADMIN_PASSWORD.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Número de WhatsApp (formato internacional, sem + nem espaços). É público no site.
VITE_WHATSAPP_NUMERO=
